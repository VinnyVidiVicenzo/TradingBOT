# ---------------------------------------------------------------------------
# crypto-research V1 environment
#
# V1 IS RESEARCH-ONLY. IT CANNOT PLACE ORDERS.
#
# There is deliberately NO BINANCE_API_KEY and NO BINANCE_API_SECRET here.
# The public market-data client signs nothing and issues GET requests only.
# If you ever find yourself wanting to add a secret to this file, stop:
# that means something outside the V1 scope is being attempted.
# ---------------------------------------------------------------------------

# Override the Binance.US public REST base URL (default: https://api.binance.us).
# Only useful for pointing tests at a local recorded-fixture server.
# CRYPTO_RESEARCH_BINANCEUS_BASE_URL=https://api.binance.us

# Where the local SQLite market-data store lives (default: ./data/market.sqlite)
# CRYPTO_RESEARCH_DB_PATH=./data/market.sqlite

# Where experiment run records are written (default: ./experiments)
# CRYPTO_RESEARCH_EXPERIMENT_DIR=./experiments
